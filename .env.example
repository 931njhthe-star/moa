# 루트 .env 예시 — 이 파일을 .env 로 복사해 값을 채운다 (.env 는 git 에 올리지 않는다)
#
#   cp .env.example .env
#
# compose 가 ${...} 치환에 읽는 값만 둔다 (docker-compose.core.yml · docker-compose.app.yml).
# LLM 키 · app_rw 비밀번호 · 운영 대시보드 비밀번호 같은 앱 비밀값은 backend/.env 에 둔다 (backend/.env.example)

# ---------- 필수 ----------
# PostgreSQL 관리자(postgres) 비밀번호 — db 컨테이너 초기화 · backend · 해석 서비스 접속에 쓴다
POSTGRES_PASSWORD=change-me

# healing 이 DB 에 붙는 healing_rw 롤 비밀번호 — backend/.env 의 HEALING_RW_PASSWORD 와 같은 값
#   (롤 비밀번호는 sql/run_sql.py 가 backend/.env 값으로 정한다)
HEALING_RW_PASSWORD=change-me

# ---------- 서버(EC2)만 ----------
# ECR 이미지 주소 — 끝의 / 까지 넣는다. 로컬에서는 비워 두면 moa-backend · moa-frontend 로컬 이미지를 쓴다
REGISTRY=
# REGISTRY=<계정 ID>.dkr.ecr.ap-northeast-2.amazonaws.com/

# 이미지 태그 — CI 배포는 커밋 sha 를 넘긴다(TAG=<sha> bash scripts/deploy.sh). 비우면 latest
TAG=

# ---------- 선택 ----------
# 주문 해석 원천 — llm(기본, 실제 LLM) · rules(같은 입력 같은 결과, 장애 실험 반복용)
INTERPRETER_SOURCE=llm

# 로컬 개발 덧씌우기(docker-compose.app.dev.yml)의 포트는 스택마다 달라 여기 두지 않는다 — 명령 앞에 붙인다
#   DEV_FRONT_PORT=8511 DEV_BACK_PORT=8001 docker compose -f docker-compose.app.yml -f docker-compose.app.dev.yml -p moa-a up -d
#   DEV_FRONT_PORT=8512 DEV_BACK_PORT=8002 docker compose -f docker-compose.app.yml -f docker-compose.app.dev.yml -p moa-b up -d
